<section class="section {{ block.variant | default('section--surface') }}" id="{{ block.id | default('quote') }}">
  <div class="container">
    <div class="two-col">
      <div>
        {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
        <h2>{{ block.heading | default('Get your honest, route-specific quote') }}</h2>
        {% if block.body %}<p class="lead">{{ block.body }}</p>{% endif %}
        {% if block.points %}
        <ul class="prose">{% for p in block.points %}<li>{{ p }}</li>{% endfor %}</ul>
        {% endif %}
        <p class="help-cta">{{ block.help_cta | default('The more you tell us, the more precise the answer. We reply on WhatsApp with a firm range and the exact steps for your route — no obligation.') }}</p>
      </div>
      <form class="quote-form lead-form" id="lead-form">
        <div class="lf-grid">
          <label>Your name<input type="text" id="lf-name" required></label>
          <label>Pet type
            <select id="lf-pet"><option>Dog</option><option>Cat</option><option>Other</option></select>
          </label>
          <label>Breed<input type="text" id="lf-breed" placeholder="e.g. Labrador"></label>
          <label>Weight (kg)<input type="number" id="lf-weight" min="0" placeholder="e.g. 28"></label>
          <label>Moving from<input type="text" id="lf-from" value="UAE (Dubai)"></label>
          <label>Moving to
            <select id="lf-to">
              <option>United Kingdom</option><option>USA</option><option>Canada</option>
              <option>Germany</option><option>France</option><option>Netherlands</option>
              <option>Australia</option><option>Singapore</option><option>India</option>
              <option>South Africa</option><option>Somewhere else</option>
            </select>
          </label>
          <label>Target travel date<input type="date" id="lf-date"></label>
          <label>Rabies vaccination
            <select id="lf-vax"><option>Already valid (≥21 days)</option><option>Done, under 21 days ago</option><option>Not yet</option><option>Not sure</option></select>
          </label>
          <label>Are you travelling too?
            <select id="lf-owner"><option>Yes, same time</option><option>No, pet travels alone</option><option>Different dates</option></select>
          </label>
          <label>How urgent?
            <select id="lf-urgency"><option>Within a month</option><option>1–3 months</option><option>3+ months</option><option>Just researching</option></select>
          </label>
          <label>Preferred contact
            <select id="lf-contact"><option>WhatsApp</option><option>Email</option><option>Phone</option></select>
          </label>
          <label>Your WhatsApp / email / phone<input type="text" id="lf-detail" required></label>
        </div>
        <button type="submit" class="btn btn-gold">Send my details</button>
        <p class="form-note" id="lf-note">No spam. We use this only to prepare your route-specific answer.</p>
      </form>
    </div>
  </div>
</section>
<script>
(function(){
  var f=document.getElementById('lead-form'); if(!f) return;
  var wa="{{ site.contact.whatsapp | default('') }}", email="{{ site.contact.email | default('') }}";
  f.addEventListener('submit',function(e){
    e.preventDefault();
    function g(id){return (document.getElementById(id)||{}).value||'';}
    var lines=[
      'New pet relocation enquiry',
      'Name: '+g('lf-name'),
      'Pet: '+g('lf-pet')+' ('+g('lf-breed')+', '+g('lf-weight')+'kg)',
      'Route: '+g('lf-from')+' -> '+g('lf-to'),
      'Travel date: '+(g('lf-date')||'flexible'),
      'Rabies status: '+g('lf-vax'),
      'Owner travelling: '+g('lf-owner'),
      'Urgency: '+g('lf-urgency'),
      'Preferred contact: '+g('lf-contact')+' ('+g('lf-detail')+')'
    ];
    var msg=lines.join('\n'), note=document.getElementById('lf-note');
    if(wa){ window.open('https://wa.me/'+wa+'?text='+encodeURIComponent(msg),'_blank'); note.textContent='Opening WhatsApp with your details…'; }
    else if(email){ window.location.href='mailto:'+email+'?subject='+encodeURIComponent('Pet relocation enquiry')+'&body='+encodeURIComponent(msg); }
    else { note.textContent='Thanks — copy these details to us: '+msg; }
  });
})();
</script>
