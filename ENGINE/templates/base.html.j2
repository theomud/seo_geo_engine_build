<!DOCTYPE html>
<html lang="{{ site.lang | default('en') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page.title }}{% if page.title_suffix is not none %}{{ page.title_suffix | default(' | ' ~ site.business.name) }}{% endif %}</title>
  {% if page.meta_description %}
  <meta name="description" content="{{ page.meta_description }}">
  {% endif %}
  <link rel="canonical" href="{{ site.url.rstrip('/') }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.og_title | default(page.title) }}">
  {% if page.meta_description %}<meta property="og:description" content="{{ page.meta_description }}">{% endif %}
  <meta property="og:url" content="{{ site.url.rstrip('/') }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.business.name }}">
  <meta name="twitter:card" content="summary_large_image">

  {% if site.assets and site.assets.favicon %}<link rel="icon" href="{{ site.assets.favicon }}">{% endif %}
  {% if site.fonts and site.fonts.google %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{{ site.fonts.google }}" rel="stylesheet">
  {% endif %}
  <link rel="stylesheet" href="/assets/theme.css">

  <!-- Structured data (SEO + GEO / answer engines) -->
  <script type="application/ld+json">
{{ jsonld[0] | tojson_ld }}
  </script>

  {% if site.analytics.ga_measurement_id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga_measurement_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.analytics.ga_measurement_id }}');
  </script>
  {% endif %}
</head>
<body data-page="{{ page.url | slugify }}" class="layout-{{ page.layout | default('page') }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">{{ site.business.mark | default('🐾') }}</span>
        <span class="brand-name">{{ site.business.name }}</span>
      </a>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
        <span></span><span></span><span></span>
      </button>
      <nav id="primary-nav" class="primary-nav" aria-label="Primary">
        <ul>
          {% for item in nav %}
          <li><a href="{{ item.url }}"{% if item.url == current_url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
        {% if site.contact.cta_label %}
        <a class="btn btn-gold nav-cta" href="{{ site.contact.cta_url | default('#quote') }}">{{ site.contact.cta_label }}</a>
        {% endif %}
      </nav>
    </div>
  </header>

  {% if breadcrumbs and breadcrumbs | length > 1 %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      {% for c in breadcrumbs %}{% if loop.last %}<span aria-current="page">{{ c.label }}</span>{% else %}<a href="{{ c.url }}">{{ c.label }}</a> <span class="bc-sep">›</span> {% endif %}{% endfor %}
    </div>
  </nav>
  {% endif %}

  <main id="main">
    {% for block in page.blocks %}
      {% set partial = 'blocks/' ~ block.type ~ '.html.j2' %}
      {% include partial ignore missing with context %}
    {% endfor %}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <span class="brand-name">{{ site.business.name }}</span>
        {% if site.business.tagline %}<p>{{ site.business.tagline }}</p>{% endif %}
        {% if site.business.disclaimer %}<p class="footer-disclaimer">{{ site.business.disclaimer }}</p>{% endif %}
      </div>
      {% for col in site.footer.columns | default([]) %}
      <div class="footer-col">
        <h4>{{ col.heading }}</h4>
        <ul>
          {% for link in col.links %}
          <li><a href="{{ link.url }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
      <div class="footer-col">
        <h4>Talk to us</h4>
        <ul>
          {% if site.contact.whatsapp %}<li><a href="https://wa.me/{{ site.contact.whatsapp }}">WhatsApp</a></li>{% endif %}
          {% if site.contact.telegram %}<li><a href="{{ site.contact.telegram }}">Telegram bot</a></li>{% endif %}
          {% if site.contact.email %}<li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>{% endif %}
          {% if site.contact.phone %}<li><a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a></li>{% endif %}
        </ul>
      </div>
    </div>
    <div class="container footer-legal">
      <p>&copy; {{ year }} {{ site.business.name }}. {{ site.footer.legal | default('All rights reserved.') }}</p>
    </div>
  </footer>

  {% if site.contact.whatsapp %}
  <a class="whatsapp-float" href="https://wa.me/{{ site.contact.whatsapp }}" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.511 5.26l-.999 3.648 3.477-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
  </a>
  {% endif %}

  <script src="/assets/main.js" defer></script>
</body>
</html>
