{# Design system generated from site.yml theme tokens — business-agnostic. #}
:root {
  --color-primary: {{ theme.primary | default('#1a365d') }};
  --color-primary-dark: {{ theme.primary_dark | default('#11233f') }};
  --color-accent: {{ theme.accent | default('#d4a853') }};
  --color-accent-dark: {{ theme.accent_dark | default('#b8893a') }};
  --color-bg: {{ theme.bg | default('#ffffff') }};
  --color-surface: {{ theme.surface | default('#f6f8fb') }};
  --color-text: {{ theme.text | default('#1f2733') }};
  --color-muted: {{ theme.muted | default('#5b6776') }};
  --color-border: {{ theme.border | default('#e3e8ef') }};
  --color-success: {{ theme.success | default('#1f8a5b') }};
  --font-body: {{ theme.font_body | default("'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif") }};
  --font-head: {{ theme.font_head | default("'Plus Jakarta Sans', 'Inter', system-ui, sans-serif") }};
  --radius: {{ theme.radius | default('14px') }};
  --radius-sm: 8px;
  --shadow: 0 10px 30px -12px rgba(16, 33, 60, .25);
  --shadow-sm: 0 4px 14px -6px rgba(16, 33, 60, .18);
  --maxw: {{ theme.max_width | default('1140px') }};
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-text);
  background: var(--color-bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.15; color: var(--color-primary); margin: 0 0 .5em; }
h1 { font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing: -.02em; }
h2 { font-size: clamp(1.5rem, 3.4vw, 2.25rem); letter-spacing: -.01em; }
h3 { font-size: 1.25rem; }
p { margin: 0 0 1rem; }
a { color: var(--color-primary); text-decoration: none; }
a:hover { text-decoration: underline; }
img { max-width: 100%; display: block; }

.container { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }
.section { padding: clamp(3rem, 7vw, 5.5rem) 0; }
.section--surface { background: var(--color-surface); }
.section--primary { background: var(--color-primary); color: #fff; }
.section--primary h1,.section--primary h2,.section--primary h3 { color: #fff; }
.eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: .78rem; font-weight: 700; color: var(--color-accent-dark); margin-bottom: .6rem; }
.section--primary .eyebrow { color: var(--color-accent); }
.lead { font-size: 1.15rem; color: var(--color-muted); max-width: 60ch; }
.section--primary .lead { color: rgba(255,255,255,.85); }
.center { text-align: center; margin-left: auto; margin-right: auto; }

/* Skip link */
.skip-link { position: absolute; left: -999px; top: 0; background: var(--color-accent); color: #1a1a1a; padding: .5rem 1rem; z-index: 100; }
.skip-link:focus { left: 8px; top: 8px; }

/* Buttons */
.btn { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; font-family: var(--font-head);
  padding: .8rem 1.4rem; border-radius: 999px; border: 2px solid transparent; cursor: pointer; transition: .18s ease; text-decoration: none; }
.btn:hover { text-decoration: none; transform: translateY(-1px); }
.btn-gold { background: var(--color-accent); color: #1a1a1a; }
.btn-gold:hover { background: var(--color-accent-dark); }
.btn-primary { background: var(--color-primary); color: #fff; }
.btn-primary:hover { background: var(--color-primary-dark); }
.btn-ghost { background: transparent; color: var(--color-primary); border-color: var(--color-border); }
.section--primary .btn-ghost { color: #fff; border-color: rgba(255,255,255,.4); }
.btn-lg { padding: 1rem 1.8rem; font-size: 1.05rem; }

/* Header */
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--color-border); }
.header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 68px; gap: 1rem; }
.brand { display: flex; align-items: center; gap: .55rem; font-family: var(--font-head); font-weight: 800; font-size: 1.25rem; color: var(--color-primary); }
.brand:hover { text-decoration: none; }
.brand-mark { font-size: 1.5rem; }
.primary-nav { display: flex; align-items: center; gap: 1.5rem; }
.primary-nav ul { display: flex; gap: 1.4rem; list-style: none; margin: 0; padding: 0; }
.primary-nav a { color: var(--color-text); font-weight: 500; font-size: .98rem; }
.primary-nav a[aria-current="page"] { color: var(--color-accent-dark); }
.nav-cta { padding: .55rem 1.1rem; }
.nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
.nav-toggle span { width: 24px; height: 2px; background: var(--color-primary); border-radius: 2px; transition: .2s; }

@media (max-width: 860px) {
  .nav-toggle { display: flex; }
  .primary-nav { position: fixed; inset: 68px 0 auto 0; background: #fff; flex-direction: column; align-items: stretch;
    gap: .5rem; padding: 1rem 20px 1.5rem; border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow);
    transform: translateY(-130%); transition: transform .25s ease; }
  .primary-nav.open { transform: translateY(0); }
  .primary-nav ul { flex-direction: column; gap: .25rem; }
  .primary-nav a { display: block; padding: .6rem 0; border-bottom: 1px solid var(--color-border); }
  .nav-cta { text-align: center; margin-top: .5rem; }
}

/* Hero */
.hero { position: relative; background:
    radial-gradient(1200px 500px at 80% -10%, rgba(212,168,83,.22), transparent 60%),
    linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff; overflow: hidden; }
.hero .container { position: relative; z-index: 2; padding-top: clamp(3rem,7vw,5rem); padding-bottom: clamp(3rem,7vw,5rem); }
.hero h1 { color: #fff; max-width: 16ch; }
.hero .lead { color: rgba(255,255,255,.88); font-size: 1.2rem; }
.hero-cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
.hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 2.5rem; align-items: center; }
.hero-trust { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 2rem; font-size: .9rem; color: rgba(255,255,255,.8); }
.hero-trust span { display: inline-flex; align-items: center; gap: .4rem; }
.hero-card { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); border-radius: var(--radius);
  padding: 1.5rem; backdrop-filter: blur(6px); }
.hero-card h3 { color: #fff; }
.hero-img { width: 100%; border-radius: var(--radius); border: 1px solid rgba(255,255,255,.2); box-shadow: var(--shadow); aspect-ratio: 3/2; object-fit: cover; }
.hero-figure { aspect-ratio: 4/3; border-radius: var(--radius); background:
   radial-gradient(120px 120px at 70% 30%, rgba(212,168,83,.5), transparent 70%),
   linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.04));
   border: 1px solid rgba(255,255,255,.2); display: grid; place-items: center; font-size: 5rem; }
@media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }

/* Pricing tiers */
.pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 2rem; }
.tier { border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; padding: 1.6rem; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); }
.tier.featured { border-color: var(--color-accent); box-shadow: var(--shadow); position: relative; }
.tier.featured::before { content: attr(data-badge); position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
  background: var(--color-accent); color: #1a1a1a; font-size: .72rem; font-weight: 700; padding: .25rem .8rem; border-radius: 999px; text-transform: uppercase; letter-spacing: .06em; }
.tier h3 { margin-bottom: .25rem; }
.tier .price { font-family: var(--font-head); font-size: 2rem; font-weight: 800; color: var(--color-primary); margin: .3rem 0; }
.tier .price small { font-size: .85rem; font-weight: 500; color: var(--color-muted); }
.tier .tier-desc { color: var(--color-muted); font-size: .92rem; margin-bottom: 1rem; }
.tier ul { list-style: none; padding: 0; margin: 0 0 1.4rem; display: grid; gap: .55rem; }
.tier li { position: relative; padding-left: 1.5rem; font-size: .95rem; }
.tier li::before { content: "✓"; position: absolute; left: 0; color: var(--color-success); font-weight: 700; }
.tier li.off { color: var(--color-muted); }
.tier li.off::before { content: "—"; color: var(--color-border); }
.tier .btn { margin-top: auto; justify-content: center; }
.price-note { color: var(--color-muted); font-size: .9rem; margin-top: 1.2rem; }
@media (max-width: 860px) { .pricing-grid { grid-template-columns: 1fr; } }

/* Cards / grids */
.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.1rem; margin-top: 2rem; }
.card { display: block; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.3rem; box-shadow: var(--shadow-sm); transition: .18s; color: inherit; }
.card:hover { transform: translateY(-3px); box-shadow: var(--shadow); text-decoration: none; }
.card .card-flag { font-size: 1.8rem; }
.card h3 { margin: .5rem 0 .3rem; font-size: 1.1rem; }
.card .card-meta { color: var(--color-muted); font-size: .9rem; }
.card .card-price { font-weight: 700; color: var(--color-accent-dark); margin-top: .5rem; }
.card .card-arrow { color: var(--color-accent-dark); font-weight: 600; margin-top: .6rem; font-size: .9rem; }

/* Checklist */
.checklist { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: .8rem 2rem; margin-top: 1.5rem; }
.checklist .ck-item { position: relative; padding-left: 2rem; }
.checklist .ck-item::before { content: "✓"; position: absolute; left: 0; top: 0; width: 1.4rem; height: 1.4rem; background: rgba(31,138,91,.12);
  color: var(--color-success); border-radius: 50%; display: grid; place-items: center; font-size: .8rem; font-weight: 700; }
.checklist .ck-item strong { display: block; }
.checklist .ck-item span { color: var(--color-muted); font-size: .92rem; }

/* Steps */
.steps { counter-reset: step; display: grid; gap: 1rem; margin-top: 1.5rem; }
.step { position: relative; padding-left: 3.4rem; }
.step::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: 0;
  width: 2.4rem; height: 2.4rem; background: var(--color-primary); color: #fff; border-radius: 50%;
  display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; }
.step h3 { font-size: 1.05rem; margin-bottom: .2rem; }
.step p { margin: 0; color: var(--color-muted); }

/* Table */
.table-wrap { overflow-x: auto; margin-top: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
table.data { width: 100%; border-collapse: collapse; font-size: .95rem; }
table.data th, table.data td { text-align: left; padding: .8rem 1rem; border-bottom: 1px solid var(--color-border); }
table.data th { background: var(--color-surface); font-family: var(--font-head); color: var(--color-primary); }
table.data tr:last-child td { border-bottom: 0; }

/* FAQ */
.faq-list { margin-top: 1.5rem; display: grid; gap: .6rem; max-width: 820px; }
.faq-item { border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #fff; overflow: hidden; }
.faq-item summary { cursor: pointer; padding: 1rem 1.2rem; font-weight: 600; font-family: var(--font-head); color: var(--color-primary); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: "+"; color: var(--color-accent-dark); font-size: 1.3rem; line-height: 1; }
.faq-item[open] summary::after { content: "–"; }
.faq-item .faq-a { padding: 0 1.2rem 1.1rem; color: var(--color-muted); }

/* Callout */
.callout { border-left: 4px solid var(--color-accent); background: var(--color-surface); border-radius: var(--radius-sm);
  padding: 1.1rem 1.3rem; margin: 1.5rem 0; }
.callout.warn { border-left-color: #d9822b; background: #fff8f0; }
.callout h4 { margin: 0 0 .3rem; color: var(--color-primary); }
.callout p:last-child { margin: 0; }

/* Trust bar */
.trust-bar { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: center; justify-content: center; }
.trust-bar .trust-item { display: flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--color-primary); }
.trust-bar .trust-item .ti-num { font-family: var(--font-head); font-size: 1.6rem; color: var(--color-accent-dark); }

/* Quote form */
.quote-form { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 640px; margin-top: 1.5rem; }
.quote-form .full { grid-column: 1 / -1; }
.quote-form label { font-size: .85rem; font-weight: 600; color: var(--color-primary); display: block; margin-bottom: .3rem; }
.quote-form input, .quote-form select { width: 100%; padding: .75rem .9rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font: inherit; background: #fff; }
.quote-form input:focus, .quote-form select:focus { outline: 2px solid var(--color-accent); border-color: var(--color-accent); }
.form-note { font-size: .82rem; color: var(--color-muted); }
.help-cta { margin-top: 1rem; font-size: .92rem; color: var(--color-primary); background: var(--color-surface); border-left: 3px solid var(--color-accent); padding: .7rem .9rem; border-radius: var(--radius-sm); }
@media (max-width: 560px) { .quote-form { grid-template-columns: 1fr; } }

/* prose */
.prose { max-width: 70ch; }
.prose ul, .prose ol { padding-left: 1.3rem; }
.prose li { margin-bottom: .4rem; }

/* Footer */
.site-footer { background: var(--color-primary-dark); color: rgba(255,255,255,.78); padding: 3rem 0 1.5rem; margin-top: 2rem; }
.footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem; }
.site-footer .brand-name { color: #fff; font-family: var(--font-head); font-weight: 800; font-size: 1.2rem; }
.footer-disclaimer { font-size: .82rem; color: rgba(255,255,255,.55); margin-top: 1rem; }
.footer-col h4 { color: #fff; font-size: .95rem; margin-bottom: .8rem; }
.footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
.footer-col a { color: rgba(255,255,255,.78); font-size: .92rem; }
.footer-col a:hover { color: var(--color-accent); }
.footer-legal { border-top: 1px solid rgba(255,255,255,.12); margin-top: 2rem; padding-top: 1.2rem; font-size: .82rem; color: rgba(255,255,255,.55); }
@media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }

/* WhatsApp float */
.whatsapp-float { position: fixed; right: 18px; bottom: 18px; width: 56px; height: 56px; border-radius: 50%;
  background: #25d366; color: #fff; display: grid; place-items: center; box-shadow: var(--shadow); z-index: 60; }
.whatsapp-float:hover { transform: scale(1.06); }

.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
@media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }

/* Key facts (quick-answer / extractable summary) */
.key-facts { border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent);
  background: var(--color-surface); border-radius: var(--radius); padding: 1.4rem 1.6rem; }
.key-facts .kf-answer { font-size: 1.12rem; color: var(--color-text); margin: 0 0 1rem; max-width: 70ch; }
.key-facts .kf-answer strong { color: var(--color-primary); }
.kf-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .8rem 1.4rem; margin: 0; padding: 0; list-style: none; }
.kf-stats li { display: flex; flex-direction: column; }
.kf-stats .kf-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--color-muted); }
.kf-stats .kf-value { font-family: var(--font-head); font-weight: 700; color: var(--color-primary); font-size: 1.05rem; }
.kf-verified { margin: 1rem 0 0; font-size: .82rem; color: var(--color-muted); display: flex; align-items: center; gap: .4rem; }
.kf-verified::before { content: "✓"; color: var(--color-success); font-weight: 700; }

/* Sources / official references */
.sources-list { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: .6rem; max-width: 820px; }
.sources-list li { display: flex; gap: .7rem; align-items: baseline; padding: .7rem .9rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #fff; }
.sources-list .src-auth { font-weight: 600; color: var(--color-primary); white-space: nowrap; }
.sources-list .src-note { color: var(--color-muted); font-size: .92rem; }
.sources-list a { word-break: break-word; }
.sources-note { color: var(--color-muted); font-size: .85rem; margin-top: .9rem; }

/* Comparison (trust gap) */
.cmp-wrap { overflow-x: auto; margin-top: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
table.cmp { width: 100%; border-collapse: collapse; font-size: .95rem; min-width: 460px; }
table.cmp th, table.cmp td { text-align: left; padding: .85rem 1rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
table.cmp thead th { background: var(--color-surface); font-family: var(--font-head); color: var(--color-muted); font-size: .85rem; }
table.cmp thead th.us, table.cmp td.us { background: rgba(212,168,83,.10); }
table.cmp thead th.us { color: var(--color-primary); }
table.cmp td.feat { font-weight: 600; color: var(--color-primary); }
table.cmp td.us { font-weight: 600; color: var(--color-text); }
table.cmp td.them { color: var(--color-muted); }
table.cmp tr:last-child td { border-bottom: 0; }
table.cmp .yes { color: var(--color-success); font-weight: 700; }
table.cmp .no { color: #c0392b; font-weight: 700; }

/* Figure / visual evidence */
figure.evidence { margin: 1.5rem 0 0; }
figure.evidence img { width: 100%; border-radius: var(--radius); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); }
.evidence-ph { aspect-ratio: 16/8; border: 1px dashed var(--color-border); border-radius: var(--radius);
  background: repeating-linear-gradient(135deg, var(--color-surface), var(--color-surface) 12px, #fff 12px, #fff 24px);
  display: grid; place-items: center; color: var(--color-muted); font-size: .95rem; }
figure.evidence figcaption { margin-top: .7rem; font-size: .88rem; color: var(--color-muted); }
figure.evidence figcaption .src { color: var(--color-muted); }
figure.evidence figcaption .src a { color: var(--color-primary); }

/* ============ Article / blog layout (2026 anatomy) ============ */
.container--article { max-width: 760px; }
.layout-article .container { max-width: 760px; }
.layout-article .section { padding: 1.1rem 0; background: #fff; }
.layout-article .section--surface { background: #fff; }
.layout-article .prose { font-size: 1.08rem; line-height: 1.75; }
.layout-article .prose p { margin: 0 0 1rem; }
.layout-article h2 { font-size: 1.5rem; margin: .6rem 0 .5rem; scroll-margin-top: 90px; }
.layout-article h3 { font-size: 1.18rem; }
.layout-article section[id] { scroll-margin-top: 90px; }

.article-head { padding: 32px 0 6px; }
.article-head .cat { text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; font-weight: 800;
  color: var(--color-accent-dark, #b5851f); text-decoration: none; }
.article-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.12; margin: .5rem 0 .6rem; }
.article-head .standfirst { font-size: 1.22rem; line-height: 1.6; color: var(--color-muted); margin: 0 0 .8rem; }
.article-head .byline { font-size: .85rem; color: var(--color-muted); display: flex; flex-wrap: wrap; gap: .4rem; }
.article-head .byline .by { font-weight: 700; color: var(--color-text); }
.article-hero { width: 100%; border-radius: var(--radius); margin-top: 1rem; box-shadow: var(--shadow); aspect-ratio: 3/2; object-fit: cover; }

.takeaways { background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent, #d4a73a);
  border-radius: var(--radius); padding: 1.1rem 1.4rem; }
.takeaways h2 { font-size: 1.1rem; margin: 0 0 .4rem; }
.takeaways ul { margin: 0; padding-left: 1.15rem; } .takeaways li { margin: .4rem 0; }

.toc { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.4rem; }
.toc h2 { font-size: 1rem; margin: 0 0 .4rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: .06em; }
.toc ol { margin: 0; padding-left: 1.2rem; } .toc li { margin: .3rem 0; }
.toc a { color: var(--color-primary); text-decoration: none; } .toc a:hover { text-decoration: underline; }

.flow { display: flex; flex-direction: column; align-items: center; gap: .35rem; margin: 1.2rem 0; }
.flow-step { background: var(--color-primary); color: #fff; border-radius: 999px; padding: .55rem 1.3rem;
  font-weight: 600; font-family: var(--font-head); font-size: .95rem; }
.flow-arrow { color: var(--color-accent-dark, #b5851f); font-weight: 800; font-size: 1.1rem; line-height: 1; }

.case { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.2rem 1.4rem; }
.case-tag { font: 800 .7rem/1 var(--font-head); text-transform: uppercase; letter-spacing: .1em; color: var(--color-accent-dark, #b5851f); }
.case h3 { margin: .5rem 0 .6rem; }
.case-rows { width: 100%; border-collapse: collapse; }
.case-rows th { text-align: left; color: var(--color-muted); font-weight: 600; padding: .35rem 0; border-bottom: 1px solid var(--color-border); }
.case-rows td { text-align: right; font-weight: 700; color: var(--color-primary); padding: .35rem 0; border-bottom: 1px solid var(--color-border); }
.case-result { margin-top: .7rem; font-weight: 800; color: var(--color-success, #2e8b57); font-size: 1.05rem; }
.case-note { margin: .6rem 0 0; font-size: .9rem; color: var(--color-muted); }

/* ============ Story block (narrative: Problem→Mistake→Discovery→Result→Lesson) ============ */
.story { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.3rem 1.5rem; }
.story-tag { font: 800 .7rem/1 var(--font-head); text-transform: uppercase; letter-spacing: .1em; color: var(--color-accent-dark, #b5851f); }
.story-lead { font-size: 1.1rem; font-style: italic; color: var(--color-text); margin: .5rem 0 1rem; }
.story-arc { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--color-accent, #d4a73a); }
.story-arc li { position: relative; padding: 0 0 1rem 1.2rem; }
.story-arc li:last-child { padding-bottom: 0; }
.story-arc li::before { content: ""; position: absolute; left: -7px; top: .35rem; width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent, #d4a73a); }
.arc-label { display: block; font: 700 .78rem var(--font-head); text-transform: uppercase; letter-spacing: .05em; color: var(--color-muted); }
.arc-text { display: block; margin-top: .15rem; }
.story-arc li:last-child .arc-label { color: var(--color-success, #2e8b57); }

/* ============ Related / cluster interlink ============ */
.related { background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-primary); border-radius: var(--radius); padding: 1rem 1.3rem; }
.related-label { display: block; font: 700 .8rem var(--font-head); text-transform: uppercase; letter-spacing: .06em; color: var(--color-muted); margin-bottom: .4rem; }
.related ul { margin: 0; padding-left: 1.1rem; } .related li { margin: .3rem 0; }
.related a { color: var(--color-primary); font-weight: 600; }
.related-note { color: var(--color-muted); font-weight: 400; }
.layout-article .related { margin: 0 auto; }

/* ============ Compliance: facts vs advice (Principle 14) ============ */
.fa-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: .6rem 0; }
@media (max-width: 640px) { .fa-grid { grid-template-columns: 1fr; } }
.fa-col { border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.2rem; }
.fa-facts { background: #eef6f0; border-left: 4px solid var(--color-success, #2e8b57); }
.fa-advice { background: var(--color-surface); border-left: 4px solid var(--color-accent, #d4a73a); }
.fa-label { font: 800 .78rem var(--font-head); text-transform: uppercase; letter-spacing: .05em; margin-bottom: .5rem; }
.fa-facts .fa-label { color: #2e7d4f; } .fa-advice .fa-label { color: var(--color-accent-dark, #b5851f); }
.fa-col ul { margin: 0; padding-left: 1.1rem; } .fa-col li { margin: .35rem 0; }
.fa-src { color: var(--color-muted); font-size: .85rem; font-weight: 600; }
.fa-note { font-size: .86rem; color: var(--color-muted); margin-top: .6rem; }

/* ============ Interactive tools (authority assets) ============ */
.tool { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.2rem 1.4rem; margin: .6rem 0; }
.tool-row { display: flex; flex-wrap: wrap; gap: .8rem; align-items: end; }
.tool-row label { display: flex; flex-direction: column; gap: .25rem; font-weight: 600; font-size: .88rem; flex: 1 1 180px; }
.tool-row input, .tool-row select { padding: .55rem .6rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font: inherit; }
.tool-row .btn { flex: 0 0 auto; }
.tool-out { margin-top: 1rem; }
.tool-table { width: 100%; border-collapse: collapse; }
.tool-table th { text-align: left; padding: .5rem .6rem .5rem 0; vertical-align: top; width: 42%; color: var(--color-primary); }
.tool-table td { padding: .5rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-muted); }
.tool-note { font-size: .8rem; color: var(--color-muted); margin: .6rem 0 0; }
.tool-ok { background:#eef6f0; border-left:4px solid var(--color-success,#2e8b57); padding:.7rem .9rem; border-radius:var(--radius-sm); }
.tool-warn { background:#fdf3e7; border-left:4px solid #d9822b; padding:.7rem .9rem; border-radius:var(--radius-sm); }
.tool-bad { background:#fdecea; border-left:4px solid #c0392b; padding:.7rem .9rem; border-radius:var(--radius-sm); }
.cc-figure { font: 800 2rem var(--font-head); color: var(--color-primary); margin:.2rem 0; }
/* qualifying lead form */
.lf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
@media (max-width: 560px){ .lf-grid { grid-template-columns: 1fr; } }
.lead-form label { display:flex; flex-direction:column; gap:.2rem; font-size:.82rem; font-weight:600; }
.lead-form input, .lead-form select { padding:.5rem .55rem; border:1px solid var(--color-border); border-radius:var(--radius-sm); font:inherit; }
.lead-form .btn { margin-top:.8rem; }

/* ============ Printable checklist ============ */
.printable { background:#fff; border:1px solid var(--color-border); border-radius:var(--radius); padding:1.2rem 1.5rem; }
.pc-group { margin: 0 0 1rem; } .pc-group h3 { margin: .4rem 0 .5rem; font-size:1.05rem; }
.pc-list { list-style:none; margin:0; padding:0; }
.pc-list li { display:flex; align-items:flex-start; gap:.6rem; margin:.45rem 0; }
.pc-box { flex:0 0 auto; width:16px; height:16px; border:2px solid var(--color-primary); border-radius:4px; margin-top:.15rem; }
.pc-source { font-size:.8rem; color:var(--color-muted); border-top:1px solid var(--color-border); padding-top:.6rem; }
.print-btn { margin-top:1rem; }
@media print {
  .site-header, .site-footer, .whatsapp-float, .print-btn, .skip-link, .breadcrumbs, .tool-row .btn { display:none !important; }
  body { background:#fff; } .section { padding:.3rem 0 !important; }
  .printable { border:none; padding:0; } main { max-width:100%; }
  a[href]:after { content:""; }
}

/* ============ Breadcrumbs ============ */
.breadcrumbs { background: var(--color-surface); border-bottom: 1px solid var(--color-border); font-size: .82rem; }
.breadcrumbs .container { padding-top: .6rem; padding-bottom: .6rem; }
.breadcrumbs a { color: var(--color-muted); text-decoration: none; }
.breadcrumbs a:hover { color: var(--color-primary); text-decoration: underline; }
.breadcrumbs span[aria-current] { color: var(--color-text); font-weight: 600; }
.breadcrumbs .bc-sep { color: var(--color-border); margin: 0 .2rem; }
