# TRUST GAP ANALYSIS — Environment Variables
# Copy to .env and fill in your values
# Never commit .env to git

# Shared APIs — same across all skills
ANTHROPIC_API_KEY=          # console.anthropic.com

# Niche-specific — change per project
NICHE_NAME=                 # e.g. pet-relocation-dubai
PROJECT_ROOT=               # Absolute path to this folder

# Skill-specific
COMPETITOR_LIST=competitors.txt
SCREENSHOTS_FOLDER=data/screenshots/
SCORES_FOLDER=data/scores/
