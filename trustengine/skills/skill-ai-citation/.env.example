# AI Citation & Generative Engine Optimisation — environment variables
# Only the variables this skill actually needs (see README + files/04-automation-spec.md).
# The on-page optimisation — direct-answer boxes, FAQPage schema, the entity definition —
# needs NO API keys. Keys are only for the OPTIONAL automated weekly citation monitor.

PROJECT_ROOT=          # absolute path to the project root on this machine

# Optional — the weekly citation monitor queries each AI engine for the 10 target queries and
# records whether the brand/page is cited. Omit any engine you do not want to poll.
PERPLEXITY_API_KEY=    # query Perplexity
OPENAI_API_KEY=        # query ChatGPT
GEMINI_API_KEY=        # query Gemini
# Note: Google AI Overview has no official API — monitor it manually (the checklist supports it).
