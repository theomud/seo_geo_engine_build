# Email Nurture Sequences — environment variables
# Only the variables this skill actually needs (see README + files/04-automation-spec.md).
# Automation 5/5: writing the 7 emails is a one-time human act; triggering, scheduling,
# personalising, and sending are fully automated by the engine once these are set.

PROJECT_ROOT=        # absolute path to the project root on this machine

# Email service provider — the engine sends and schedules the sequence through this.
ESP_API_KEY=         # API key for the sending provider (e.g. SendGrid / Postmark / Mailgun / SES)
FROM_EMAIL=          # the verified sending address (must be authenticated: SPF/DKIM)
FROM_NAME=           # advisor / brand name shown as the sender
REPLY_TO_EMAIL=      # where help-first replies land — a human reads and answers these

# Notes:
# - No AI key is required to SEND the sequence — the emails are pre-written and verified.
# - Personalisation tokens ({{first_name}}, {{origin_country}}, {{destination}},
#   {{flight_date}}) are filled per lead from the lead-capture record, not from an API.
