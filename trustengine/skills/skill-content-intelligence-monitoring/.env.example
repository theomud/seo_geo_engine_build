# Content Intelligence Monitoring — environment variables
# Only the variables this skill actually needs (see README + files/04-automation-spec.md).
# The DETERMINISTIC CORE — RICE scoring, routing, and report generation — needs NO API keys
# and runs anywhere. Keys are ONLY to CONNECT the live collectors. A stream with no key is
# listed "awaiting connection" in the report and contributes no signal — it is never fabricated.

PROJECT_ROOT=             # absolute path to the project root on this machine
MONITOR_REPORT_DATE=      # optional — fixes the report's cycle date (default 2026-06-01) so output is reproducible

# Optional — the live collectors. Set a key to connect that stream; omit any you don't run.
VISUALPING_WEBHOOK_URL=   # streams 1-3, 5 — page-change webhooks (MOCCAE, destination authorities, airlines, competitors)
SERPAPI_KEY=              # stream 5 — competitor SERP / content-change checks
ANTHROPIC_API_KEY=        # stream 6 — monthly competitor Trust-Score re-audit
REDDIT_CLIENT_ID=         # streams 7, 10 — competitor positioning + community fear signals (PRAW)
GSC_REFRESH_TOKEN=        # stream 8 — Google Search Console daily performance (position/click drops)
PERPLEXITY_API_KEY=       # stream 9 — AI citation tracking
GBP_API_KEY=              # stream 11 — Google Business Profile review monitoring
# Note: streams 4 and 12 (UAE-gov broader + industry signals) are Google Alerts — reviewed
# manually, no API key. The engine lists them as "manual/alerts".
