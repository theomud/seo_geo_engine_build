# CONTENT STRUCTURE FOR TRUST — Environment Variables
# Copy to .env and fill in your values
# Never commit .env to git

# Shared — already set up from previous skills
ANTHROPIC_API_KEY=          # console.anthropic.com

# Niche-specific
NICHE_NAME=                 # e.g. pet-relocation-dubai
PROJECT_ROOT=               # Absolute path to this folder

# Input files — from other skills
FEAR_INTELLIGENCE_SPREADSHEET=   # path to customer-fear-intelligence-output.xlsx
SOURCE_BANK_SPREADSHEET=         # path to skill-02-source-bank.xlsx

# Skill outputs
CONTENT_BRIEFS_OUTPUT=content-structure-briefs.md
PAGE_TEMPLATES_OUTPUT=content-structure-templates/
