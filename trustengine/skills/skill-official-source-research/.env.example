# Skill 02 — Official Source Research
# Copy this to .env (in this skill folder) and fill values from project root .env
# Never commit .env to git

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SHARED — same as project root .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ANTHROPIC_API_KEY=           # console.anthropic.com — required for claim matching

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NICHE-SPECIFIC — changes per project (Dubai pet relocation values shown)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NICHE_NAME=dubai-pet-relocation
NICHE_LOCATION=ae             # Country code (ae, gb, us, in, au, za)
NICHE_LANGUAGE=en             # Language code (en, ar)
PROJECT_ROOT=                 # Absolute path to this project folder

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SKILL 02 — SPECIFIC
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━

SKILL_NUMBER=02
SKILL_SPREADSHEET=skill-02-source-bank.xlsx

# No additional API keys needed for Skill 02.
# Verification uses Playwright (free) to visit official source URLs +
# Anthropic API to match extracted text against pending claims.
