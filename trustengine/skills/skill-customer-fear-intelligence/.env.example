# CUSTOMER FEAR INTELLIGENCE — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# Shared
ANTHROPIC_API_KEY=        # console.anthropic.com — intent + fear classification
PROJECT_ROOT=             # absolute path to this skill folder
NICHE_NAME=               # e.g. pet-relocation-dubai

# Keyword collection (multi-source)
SERPAPI_KEY=              # SerpApi — Autocomplete + PAA + Related Searches + organic
DATAFORSEO_LOGIN=         # DataForSEO — search volume / difficulty (optional)
DATAFORSEO_PASSWORD=

# Community research (verbatim fear language)
REDDIT_CLIENT_ID=         # reddit.com/prefs/apps — full thread extraction via PRAW
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=        # e.g. fear-intelligence-research/1.0

# Skill inputs / outputs
SEEDS_FILE=seeds.txt
KEYWORD_SPREADSHEET=data/skill-01-keyword-collection.xlsx
